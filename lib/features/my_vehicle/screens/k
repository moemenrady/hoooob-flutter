  Widget _defaultAddDocument({
    required AddCarController controller,
    required String nameDocument,
    required String keyName,
  }) {
    return Container(
      padding: const EdgeInsets.all(Dimensions.paddingSizeSmall),
      width: MediaQuery.of(context).size.width,
      height: MediaQuery.of(context).size.height * 0.06,
      decoration: BoxDecoration(
          color: Theme.of(context).cardColor,
          border: Border.all(color: Theme.of(context).hintColor),
          borderRadius: BorderRadius.circular(Dimensions.paddingSizeDefault)),
      child: InkWell(
        onTap: () async {
          bool res = await controller.pickOtherFile(keyName);
          if (res) {
            controller.documents.removeWhere((doc) => doc.key == keyName);
            controller.documents
                .add(MultipartDocument(keyName, controller.objFile!));
            _scrollDown();
          }
        },
        child: Builder(builder: (context) {
          return Row(
            mainAxisAlignment: MainAxisAlignment.center,
            crossAxisAlignment: CrossAxisAlignment.center,
            children: [
              Text(nameDocument,
                  style: textRegular.copyWith(
                    fontSize: Dimensions.fontSizeDefault,
                    color: Theme.of(context).textTheme.labelMedium!.color,
                  )),
              Spacer(),
              Image.asset(
                Images.addImageIcon,
                width: MediaQuery.of(context).size.width * 0.07,
              ),
              controller.selectedFileForImport != null
                  ? Text(controller.objFile?.name ?? 'upload_file'.tr,
                      maxLines: 2, overflow: TextOverflow.ellipsis)
                  : Text('upload_file'.tr, style: textRegular.copyWith()),
            ],
          );
        }),
      ),
    );
